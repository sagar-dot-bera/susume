    },
    "devDependencies": {
        "tailwindcss": "^3.4.0",
        "daisyui": "^4.0.0",
        "autoprefixer": "^10.4.0",
        "postcss": "^8.4.0"
    },
    "keywords": [
        "tailwind",
        "daisyui",
        "saaS"
    ],
