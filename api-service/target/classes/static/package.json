{
    "name": "recommendation-engine-frontend",
    "version": "1.0.0",
    "description": "Frontend for Recommendation Engine SaaS",
    "scripts": {
        "build": "tailwindcss -i ./css/input.css -o ./css/output.css",
        "dev": "tailwindcss -i ./css/input.css -o ./css/output.css --watch",
